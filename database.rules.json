{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "conversations": {
      "$cid": {
        ".read": "auth != null && (!data.exists() || data.child('members/' + auth.uid).exists())",
        ".write": "auth != null && !data.exists() && newData.child('members/' + auth.uid).exists()",

        "lastMessage": {
          ".write": "auth != null && data.parent().child('members/' + auth.uid).exists()"
        },
        "lastSenderId": {
          ".write": "auth != null && data.parent().child('members/' + auth.uid).exists()"
        },
        "lastSenderName": {
          ".write": "auth != null && data.parent().child('members/' + auth.uid).exists()"
        },
        "lastType": {
          ".write": "auth != null && data.parent().child('members/' + auth.uid).exists()"
        },
        "updatedAt": {
          ".write": "auth != null && data.parent().child('members/' + auth.uid).exists()"
        }
      }
    },

    "messages": {
      "$cid": {
        ".read": "auth != null && root.child('conversations/' + $cid + '/members/' + auth.uid).exists()",
        ".indexOn": ["createdAt"],
        "$mid": {
          ".write": "auth != null && !data.exists() && newData.child('senderId').val() == auth.uid && root.child('conversations/' + $cid + '/members/' + auth.uid).exists()",
          "recalled": {
            ".write": "auth != null && data.parent().child('senderId').val() == auth.uid"
          },
          "reactions": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && root.child('conversations/' + $cid + '/members/' + auth.uid).exists()"
            }
          }
        }
      }
    },

    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$cid": {
          ".write": "auth != null && (auth.uid == $uid || root.child('conversations/' + $cid + '/members/' + auth.uid).exists())"
        }
      }
    },

    "active": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "readStatus": {
      "$cid": {
        ".read": "auth != null && root.child('conversations/' + $cid + '/members/' + auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && root.child('conversations/' + $cid + '/members/' + auth.uid).exists()"
        }
      }
    },

    "typing": {
      "$cid": {
        ".read": "auth != null && root.child('conversations/' + $cid + '/members/' + auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && root.child('conversations/' + $cid + '/members/' + auth.uid).exists()"
        }
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$nid": {
          ".write": "auth != null && (auth.uid == $uid || (newData.exists() && newData.child('convId').exists() && root.child('conversations/' + newData.child('convId').val() + '/members/' + auth.uid).exists()))"
        }
      }
    }
  }
}
