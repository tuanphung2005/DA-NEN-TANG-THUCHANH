{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "userConvs": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null"
      }
    },
    "conversations": {
      "$cid": {
        ".read": "auth != null && data.child('members/' + auth.uid).exists()",
        ".write": "auth != null && (data.child('members/' + auth.uid).exists() || newData.child('members/' + auth.uid).exists())",
        "messages": {
          ".indexOn": ["createdAt"]
        }
      }
    }
  }
}
